file(STRINGS "${MANIFEST}" _files)
file(GLOB_RECURSE _bundled_fonts "${RESOURCE_DIR}/*.ttf" "${RESOURCE_DIR}/*.otf"
    "${RESOURCE_DIR}/*.ttc" "${RESOURCE_DIR}/Assets/Fonts/*")
if(_bundled_fonts)
    message(FATAL_ERROR "Runtime resources unexpectedly bundle fonts: ${_bundled_fonts}")
endif()
foreach(_file IN LISTS _files)
    if(NOT EXISTS "${RESOURCE_DIR}/${_file}")
        message(FATAL_ERROR "Missing runtime resource: ${RESOURCE_DIR}/${_file}. Build npgs_resources and npgs_shaders first.")
    endif()
endforeach()
file(GLOB_RECURSE _actual LIST_DIRECTORIES false RELATIVE "${RESOURCE_DIR}"
    "${RESOURCE_DIR}/Assets/*")
list(FILTER _actual EXCLUDE REGEX "^Assets/Shaders/.*\\.d$")
list(SORT _files)
list(SORT _actual)
if(NOT _actual STREQUAL _files)
    message(FATAL_ERROR "Runtime resource files do not match the generated manifest")
endif()
list(LENGTH _files _count)
message(STATUS "Verified ${_count} runtime resources")
