{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux Wayland / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "linux-release",
      "inherits": "linux-debug",
      "displayName": "Linux Wayland / Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-resources",
      "inherits": "linux-debug",
      "displayName": "Linux shader and resource validation only",
      "binaryDir": "${sourceDir}/build/resources",
      "cacheVariables": { "NPGS_BUILD_APPLICATION": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug", "jobs": 4 },
    { "name": "linux-release", "configurePreset": "linux-release", "jobs": 4 },
    { "name": "linux-resources", "configurePreset": "linux-resources", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "linux-resources", "configurePreset": "linux-resources", "output": { "outputOnFailure": true } }
  ]
}
